{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "types": ["@webgpu/types", "node"],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "tsup.config.ts", "scripts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
